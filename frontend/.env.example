# Frontend configuration (Vite). Copy to `.env` and set your own values.
# All variables must be prefixed with VITE_ to be exposed to the client.
# NOTE: `.env` is gitignored — keep real hosts out of the committed source.

# Default server host (domain or IP) prefilled in the TCP and UDP clients.
VITE_DEFAULT_HOST=your-server.example.com

# Default URL prefilled in the API Tester.
# If unset, it is derived as http://${VITE_DEFAULT_HOST}:7000/api/pushData
VITE_DEFAULT_API_URL=http://your-server.example.com:7000/api/pushData
